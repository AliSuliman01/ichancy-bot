# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TRANSACTIONS_TELEGRAM_BOT_TOKEN=your_transactions_bot_token_here
BOT_NAME=your_bot_name_here

# Admin Configuration
ADMIN_TELEGRAM_ID=your_admin_telegram_id_here
ADMIN_CHAT_ID=your_admin_chat_id_here

# Telegram Channels and Groups (comma-separated)
TELEGRAM_CHANNELS=channel1,channel2,channel3
TELEGRAM_GROUPS=group1,group2,group3

# iChancy Configuration
ICHANCY_COOKIE=your_ichancy_cookie_string_here
COOKIE_FROM_GROUP_ID=your_cookie_from_group_id_here
PARENT_ID=your_parent_id_here
EXCHANGE_RATE=1

# Device Configuration
USER_AGENT=your_user_agent_string_here

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=your_db_username_here
DB_PASSWORD=your_db_password_here
DB_NAME=your_database_name_here

# Crypto Configuration (group IDs, space-separated)
CRYPTO_DEPOSIT_GROUP=your_crypto_deposit_group_id_here
CRYPTO_WITHDRAW_GROUP=your_crypto_withdraw_group_id_here

# BEMO Configuration (group IDs, space-separated)
BEMO_DEPOSIT_GROUP=your_bemo_deposit_group_id_here
BEMO_WITHDRAW_GROUP=your_bemo_withdraw_group_id_here

# Syriatel Configuration (group IDs, space-separated)
SYRIATEL_DEPOSIT_GROUP=your_syriatel_deposit_group_id_here
SYRIATEL_WITHDRAW_GROUP=your_syriatel_withdraw_group_id_here

# ShamCash Configuration (group IDs, space-separated)
SHAMCASH_DEPOSIT_GROUP=your_shamcash_deposit_group_id_here
SHAMCASH_WITHDRAW_GROUP=your_shamcash_withdraw_group_id_here
