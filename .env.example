# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_database_password
DB_NAME=cicp_bot

# Django Configuration
DJANGO_SECRET_KEY=your-secret-key-here-generate-a-random-one
DEBUG=False
ALLOWED_HOSTS=your-domain.com,localhost,127.0.0.1

# Django Superuser (optional - for initial setup)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change_this_password

# Telegram Bot Configuration (can also be set via Django admin Settings model)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
ADMIN_TELEGRAM_ID=your_admin_telegram_id
ADMIN_CHAT_ID=your_admin_chat_id
ICHANCY_COOKIE=your_ichancy_cookie
PARENT_ID=your_parent_id
EXCHANGE_RATE=1.00
USER_AGENT=your_user_agent
BOT_NAME=your_bot_name

# Telegram Groups (optional)
TELEGRAM_CHANNELS=@channel1,@channel2
TELEGRAM_GROUPS=@group1,@group2
COOKIE_FROM_GROUP_ID=your_cookie_group_id
CRYPTO_DEPOSIT_GROUP=your_crypto_deposit_group
CRYPTO_WITHDRAW_GROUP=your_crypto_withdraw_group
BEMO_DEPOSIT_GROUP=your_bemo_deposit_group
BEMO_WITHDRAW_GROUP=your_bemo_withdraw_group
SYRIATEL_DEPOSIT_GROUP=your_syriatel_deposit_group
SYRIATEL_WITHDRAW_GROUP=your_syriatel_withdraw_group
SHAMCASH_DEPOSIT_GROUP=your_shamcash_deposit_group
SHAMCASH_WITHDRAW_GROUP=your_shamcash_withdraw_group

# Transactions Bot (optional)
TRANSACTIONS_TELEGRAM_BOT_TOKEN=your_transactions_bot_token

# Security (for production)
SECURE_SSL_REDIRECT=False
